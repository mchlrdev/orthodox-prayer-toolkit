{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orthodox-prayer-toolkit.local/schemas/prayer.schema.json",
  "title": "Orthodox Prayer (multilingual, model A)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "variants", "structure"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Stable slug; filename must be {id}.json"
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "description": "Genre slug (prayer, troparion, kontakion, …) — open string"
    },
    "book": { "type": "string", "minLength": 1 },
    "occasion": { "type": "string", "minLength": 1 },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Short summary of the prayer (shared across languages)"
    },
    "tone": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 8
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lang", "variant", "title", "license", "source"],
        "properties": {
          "lang": {
            "type": "string",
            "minLength": 1,
            "description": "BCP-47 language code where possible"
          },
          "variant": {
            "type": "string",
            "minLength": 1,
            "description": "Edition/script slug within the language"
          },
          "title": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 }
        }
      }
    },
    "structure": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "translations"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Stable block id within the prayer"
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "description": "Open semantic role string (not a closed enum)"
          },
          "translations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["lang", "variant"],
              "properties": {
                "lang": { "type": "string", "minLength": 1 },
                "variant": { "type": "string", "minLength": 1 },
                "text": { "$ref": "#/$defs/inlineContent" },
                "lines": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/inlineContent" }
                }
              },
              "anyOf": [
                { "required": ["text"] },
                { "required": ["lines"] }
              ]
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "custom": {
          "type": "object",
          "description": "Arbitrary prayer-specific metadata key/value pairs",
          "propertyNames": { "type": "string", "minLength": 1 },
          "additionalProperties": {
            "type": ["string", "number", "boolean", "null"]
          }
        }
      }
    }
  },
  "$defs": {
    "textRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t", "v"],
      "properties": {
        "t": {
          "type": "string",
          "enum": ["text", "note"],
          "description": "text = prayer wording; note = inline rubric/annotation"
        },
        "v": {
          "type": "string",
          "minLength": 1,
          "description": "Run contents (notes should not include surrounding spaces)"
        }
      }
    },
    "inlineContent": {
      "description": "Plain string, or run list when inline notes are present",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/textRun" }
        }
      ]
    }
  }
}
