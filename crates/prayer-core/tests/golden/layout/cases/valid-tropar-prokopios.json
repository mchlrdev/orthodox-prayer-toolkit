          {
            "kind": "verse",
            "styleName": "verse",
            "lines": [
              [
                {
                  "t": "text",
                  "v": "Dein Märtyrer Prokopius, Herr,"
                }
              ],
              [
                {
                  "t": "text",
                  "v": "hat in seinem Leidenskampf den Kranz der Unvergänglichkeit erworben;"
                }
              ],
              [
                {
                  "t": "text",
                  "v": "denn mit seiner Kraft hat er die Tyrannen besiegt"
                }
              ],
              [
                {
                  "t": "text",
                  "v": "und die Dämonen kraftlos gemacht."
                }
              ],
              [
                {
                  "t": "text",
                  "v": "Durch seine Fürbitten, Christus Gott, rette unsere Seelen."
                }
              ]
            ]
          }
        ]
      },
