{
  "name": "orthodox-prayer-toolkit",
  "private": true,
  "version": "0.1.4",
  "description": "Standalone toolkit for liturgical prayer JSON (schema, validate, export) and a local-first Electron editor",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @orthodox-prayer-toolkit/app dev",
    "dev:electron": "pnpm --filter @orthodox-prayer-toolkit/app dev:electron",
    "dist": "pnpm --filter @orthodox-prayer-toolkit/app dist",
    "dist:dir": "pnpm --filter @orthodox-prayer-toolkit/app dist:dir",
    "release": "node ./scripts/release.mjs",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mchlrdev/orthodox-prayer-toolkit.git"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.15.1",
  "devDependencies": {
    "bumpp": "^12.2.0"
  }
}
